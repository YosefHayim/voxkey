{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "paths": { "@fugood/whisper.node": ["./src/dictation/whisperNode.d.ts"] }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/scripts/dev", "src/**/*.test.ts"]
}
